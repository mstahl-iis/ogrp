{
  "$id": "https://mstahl-iis.github.io/ogrp/next/pvt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Position, Velocity, Time (PVT)",
  "description": "Position and velocity refer to earth-centered, earth-fixed cartesian coordinate system defined by `datum`.",
  "type": "object",
  "properties": {
    "datum": {
      "$ref": "#/$defs/GeodeticDatum"
    },
    "pos": {
      "$ref": "#/$defs/Cartesian Position"
    },
    "vel": {
      "$ref": "#/$defs/Cartesian Velocity"
    },
    "time": {
      "$ref": "#/$defs/GnssSystemTime"
    },
    "cov": {
      "$ref": "#/$defs/CovarianceMatrix"
    },
    "fix": {
      "description": "Type of position fix.",
      "enum": [
        "none",
        "2D",
        "3D",
        "DGPS",
        "RTK",
        "PPP"
      ]
    }
  },
  "required": [
    "datum",
    "pos",
    "time",
    "fix"
  ],
  "$defs": {
    "GeodeticDatum": {
      "description": "A Geodetic Datum consists of a referencen frame and optional definition of epoch and ellipsoid.",
      "type": "object",
      "properties": {
        "frame": {
          "type": "string",
          "description": "Geodetic reference frame/datum (e.g., ITRF2020, WGS84(G2139), ETRS89, NAD83(2011))."
        },
        "epoch": {
          "type": "number",
          "description": "Reference epoch of coordinates as decimal year (e.g., 2025.0). Required if the frame is time-dependent."
        },
        "ellipsoid": {
          "type": "object",
          "description": "Reference ellipsoid. If omitted, it is implied by reference frame (e.g., WGS 84).",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "e.g., WGS84, GRS80"
            },
            "a": {
              "type": "number",
              "description": "Semi-major axis a, meters."
            },
            "f": {
              "type": "number",
              "description": "Flattening f (unitless).",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            }
          }
        }
      },
      "required": [
        "frame"
      ]
    },
    "Cartesian Position": {
      "description": "Cartesian coordinates in meters.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "Position in X",
          "type": "number",
          "description": "meters"
        },
        "y": {
          "title": "Position in Y",
          "type": "number",
          "description": "meters"
        },
        "z": {
          "title": "Position in Z",
          "type": "number",
          "description": "meters"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ]
    },
    "Cartesian Velocity": {
      "description": "Cartesian velocity in meters per second.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vx": {
          "title": "Velocity in X",
          "type": "number",
          "description": "m/s"
        },
        "vy": {
          "title": "Velocity in Y",
          "type": "number",
          "description": "m/s"
        },
        "vz": {
          "title": "Velocity in Z",
          "type": "number",
          "description": "m/s"
        }
      },
      "required": [
        "vx",
        "vy",
        "vz"
      ]
    },
    "GnssSystem": {
      "enum": [
        "GPS",
        "Galileo",
        "Glonass",
        "BeiDou",
        "QZSS",
        "IRNSS",
        "SBAS"
      ]
    },
    "GnssSystemTime": {
      "type": "object",
      "description": "Native GNSS system time in week and time of week in milliseconds. No leap seconds for GPS/Galileo/BeiDou; GLONASS is UTC-like.",
      "additionalProperties": false,
      "properties": {
        "system": {
          "$ref": "#/$defs/GnssSystem"
        },
        "week": {
          "title": "GNSS week number",
          "type": "integer",
          "minimum": 0
        },
        "tow_ms": {
          "title": "Milliseconds of week",
          "type": "integer",
          "minimum": 0,
          "maximum": 604799000
        },
        "offset_ns": {
          "type": "number",
          "minimum": -500000,
          "maximum": 500000,
          "description": "Clock offset in nanoseconds"
        },
        "drift_ns_per_s": {
          "type": "number",
          "description": "Clock drift in ns/s"
        },
        "leapSeconds": {
          "title": "UTC–GNSS leap seconds",
          "type": "integer",
          "description": "Number of leap seconds (GNSS-UTC) applicable at this epoch."
        }
      },
      "required": [
        "system",
        "week",
        "tow_ms"
      ]
    },
    "CovarianceMatrix": {
      "type": "object",
      "description": "Upper-triangular elements of a symmetric 4×4 covariance matrix for variables {t, x, y, z}. Units must match the associated state components.",
      "additionalProperties": false,
      "properties": {
        "tt": {
          "title": "Variance (t)",
          "type": "number",
          "minimum": 0
        },
        "xx": {
          "title": "Variance (x)",
          "type": "number",
          "minimum": 0
        },
        "yy": {
          "title": "Variance (y)",
          "type": "number",
          "minimum": 0
        },
        "zz": {
          "title": "Variance (z)",
          "type": "number",
          "minimum": 0
        },
        "xt": {
          "title": "Covariance (x, t)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "xy": {
          "title": "Covariance (x, y)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "xz": {
          "title": "Covariance (x, z)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "yt": {
          "title": "Covariance (y, t)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "yz": {
          "title": "Covariance (y, z)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "zt": {
          "title": "Covariance (z, t)",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      },
      "required": [
        "tt",
        "xt",
        "xx",
        "xy",
        "xz",
        "yt",
        "yy",
        "yz",
        "zt",
        "zz"
      ]
    }
  }
}

{
  "$id": "https://mstahl-iis.github.io/ogrp/next/pvt-message",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OGRP PVT message",
  "description": "The PVT message contains a minimal set of properties computed by each PVT algorithm.",
  "type": "object",
  "allOf": [
    {
      "$ref": "#/$defs/BaseProperties"
    },
    {
      "$ref": "#/$defs/CustomProperties"
    }
  ],
  "properties": {
    "$schema": {
      "const": "https://mstahl-iis.github.io/ogrp/next/pvt-message"
    },
    "pvt": {
      "$ref": "https://mstahl-iis.github.io/ogrp/next/pvt"
    }
  },
  "$defs": {
    "BaseProperties": {
      "$comment": "Generic properties for OGRP messages.",
      "type": "object",
      "properties": {
        "$schema": {
          "description": "The schema of this OGRP message.",
          "type": "string",
          "format": "uri"
        },
        "$epoch": {
          "title": "Epoch marker",
          "description": "Either UUIDv1 or UUIDv6 according to RFC9562. The Node ID should be the MAC address of the GNSS receiver.",
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "$schema",
        "$epoch"
      ]
    },
    "CustomProperties": {
      "$comment": "Custom properties must be prefixed by 'x-'",
      "patternProperties": {
        "^x-": true
      }
    }
  }
}
